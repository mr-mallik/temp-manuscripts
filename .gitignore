# Compiled PDFs are build output. To commit a submitted/accepted
# version, force-add it:  git add -f journals/<name>/submitted.pdf
*.pdf
# ...but keep PDF figures and supplementary material
!shared/figures/**/*.pdf
!journals/**/figures/**/*.pdf
!journals/**/supplementary/**/*.pdf

# ---------------------------------------------------------------
# Overleaf sync
# ---------------------------------------------------------------
# Session cookie - can log in to your Overleaf account. NEVER commit.
.olauth
# Local copies of the shared bibliography made for Overleaf/Tectonic
# (shared/references/references.bib is the source of truth)
journals/*/references.bib

# ---------------------------------------------------------------
# Python / notebooks (shared/evaluation)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
*.bak
*.sav
.DS_Store
Thumbs.db
desktop.ini
